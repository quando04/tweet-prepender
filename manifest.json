{
  "manifest_version": 3,
  "name": "Tweet Prepender",
  "version": "1.0.0",
  "description": "Automatically add your chosen text to the beginning of every X (formerly Twitter) post. Save time and keep your posts consistent.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "action": {
    "default_title": "Tweet Prepender",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icons/icon-16.png",
      "48": "images/icons/icon-48.png",
      "128": "images/icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "images/icons/icon-16.png",
    "48": "images/icons/icon-48.png",
    "128": "images/icons/icon-128.png"
  }
}
